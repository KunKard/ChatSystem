<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LogicCheck</RootNamespace>
    <!-- 与 Unity 2022.3 保持一致：C# 9，不使用可空引用类型标注 -->
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 桩代码里有意保留未使用的参数，不要因此产生噪音 -->
    <NoWarn>CS0169;CS0649;CS0067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="UnityShim.cs" />
    <Compile Include="Program.cs" />
    <!-- 直接编译工程里的真实源码，而不是拷贝一份，避免验的东西和跑的东西不一致 -->
    <Compile Include="../Assets/Scripts/Data/**/*.cs" />
    <Compile Include="../Assets/Scripts/Runtime/**/*.cs" />
    <!-- 策划工具里"只算不报"的那一半。逐个列出而不是用 Assets/Scripts/Editor/**/*.cs：
         同目录下的 DialogueEditor.cs / DialoguePreviewState.cs 必然 using UnityEditor，
         通配会把它们一起拖进来直接编译失败。这份清单同时也是"哪些文件必须保持
         编辑器无关"的机器可读记录 —— 谁把 AssetDatabase 写进校验器，这里立刻红给他看 -->
    <Compile Include="../Assets/Scripts/Editor/ValidationIssue.cs" />
    <Compile Include="../Assets/Scripts/Editor/DialogueValidator.cs" />
    <Compile Include="../Assets/Scripts/Editor/NodeIdUtility.cs" />
  </ItemGroup>

</Project>
